# ── Never commit secrets ─────────────────────────────────────
.env
.env.*
*.local
# Wrangler local secrets file. Comments must sit on their own line:
# git does not support trailing comments, so 'pattern  # note' never matched.
.dev.vars
.dev.vars.*
!.dev.vars.example
worker/.dev.vars
worker/.wrangler/
.wrangler/
secrets.json
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# ── Never commit personal data ───────────────────────────────
# exported subscriber lists
subscribers.json
subscribers.csv
*.sqlite
*.db
exports/

# ── Newsletter ───────────────────────────────────────────────
# drafts stay private until sent
newsletter/issues/
# generated by --dry, never needed in git
newsletter/preview.html

# ── Tooling noise ────────────────────────────────────────────
node_modules/
npm-debug.log*
package-lock.json
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~