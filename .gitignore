# ── Never commit secrets ─────────────────────────────────────
.env
.env.*
*.local
.dev.vars                 # Wrangler local secrets file
worker/.dev.vars
worker/.wrangler/
secrets.json
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# ── Never commit personal data ───────────────────────────────
subscribers.json          # exported subscriber lists
subscribers.csv
*.sqlite
*.db
exports/

# ── Newsletter ───────────────────────────────────────────────
newsletter/issues/        # drafts stay private until sent
newsletter/preview.html   # generated by --dry, never needed in git

# ── Tooling noise ────────────────────────────────────────────
node_modules/
npm-debug.log*
package-lock.json
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~